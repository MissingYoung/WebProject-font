# Auto detect text files and normalize line endings to LF
* text=auto
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.config.js text eol=lf
*.eslintrc* text eol=lf
*.prettierrc* text eol=lf
